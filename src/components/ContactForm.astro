---
import { site } from '../data/site';
import type { Copy } from '../i18n';

interface Props {
  form: Copy['form'];
}

const { form } = Astro.props;
---

<form
  class="contact-form"
  data-contact-form
  data-email={site.email}
  data-subject-lead={form.subjectLead}
  data-label-name={form.labelName}
  data-label-company={form.labelCompany}
  data-label-email={form.labelEmail}
  data-status={form.status}
  action={`mailto:${site.email}`}
  method="post"
  enctype="text/plain"
>
  <div class="field">
    <label for="name">{form.name}</label>
    <input id="name" name="name" type="text" autocomplete="name" required />
  </div>
  <div class="field">
    <label for="company">{form.company} <span class="optional">{form.optional}</span></label>
    <input id="company" name="company" type="text" autocomplete="organization" />
  </div>
  <div class="field">
    <label for="email">{form.email}</label>
    <input id="email" name="email" type="email" autocomplete="email" inputmode="email" required />
  </div>
  <div class="field">
    <label for="message">{form.message}</label>
    <textarea id="message" name="message" rows="6" required></textarea>
  </div>
  <button class="button" type="submit">{form.submit}</button>
  <p id="form-status" class="form-status" role="status" hidden></p>
  <p class="form-note">
    {form.note} <a href={`mailto:${site.email}`}>{site.email}</a>.
  </p>
</form>
