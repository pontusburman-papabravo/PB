---
import { normalizePath } from '../data/site';
import { getCopy, localizePath, localeFromPath } from '../i18n';

interface Props {
  path: string;
}

const { path } = Astro.props;
const locale = localeFromPath(path);
const copy = getCopy(locale);
const current = normalizePath(path);
const enHref = localizePath('en', path);
const svHref = localizePath('sv', path);
---

<header class="site-header">
  <div class="header-bar">
    <a class="wordmark" href={localizePath(locale, '/')}>Papa Bravo</a>
    <div class="header-actions">
      <nav class="lang-switch" aria-label={locale === 'sv' ? 'Språk' : 'Language'}>
        <a
          href={enHref}
          hreflang="en"
          lang="en"
          aria-label="English"
          aria-current={locale === 'en' ? 'true' : undefined}
        >
          EN
        </a>
        <a
          href={svHref}
          hreflang="sv"
          lang="sv"
          aria-label="Svenska"
          aria-current={locale === 'sv' ? 'true' : undefined}
        >
          SV
        </a>
      </nav>
      <a class="button button-small" href={localizePath(locale, '/contact')}>{copy.ctaLabel}</a>
      <button
        class="nav-toggle"
        type="button"
        data-nav-toggle
        data-label-menu={copy.menu}
        data-label-close={copy.close}
        aria-expanded="false"
        aria-controls="site-nav"
      >
        <span data-nav-label>{copy.menu}</span>
      </button>
    </div>
    <nav id="site-nav" class="site-nav" aria-label={copy.navLabel}>
      <ul>
        {
          copy.nav.map((item) => {
            const href = localizePath(locale, item.path);
            return (
              <li>
                <a href={href} aria-current={current === href ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
  </div>
</header>
