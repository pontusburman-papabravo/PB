---
import { normalizePath } from '../data/site';
import { getCopy, localizePath, localeFromPath, type Locale } from '../i18n';

interface Props {
  path: string;
}

const { path } = Astro.props;
const locale = localeFromPath(path);
const copy = getCopy(locale);
const current = normalizePath(path);
const altLocale: Locale = locale === 'en' ? 'sv' : 'en';
const altHref = localizePath(altLocale, path);
const altLabel = altLocale === 'sv' ? 'Svenska' : 'English';
---

<header class="site-header">
  <div class="header-bar">
    <a class="wordmark" href={localizePath(locale, '/')}>Papa Bravo</a>
    <div class="header-actions">
      <a class="button button-small" href={localizePath(locale, '/contact')}>{copy.ctaLabel}</a>
      <button
        class="nav-toggle"
        type="button"
        data-nav-toggle
        data-label-menu={copy.menu}
        data-label-close={copy.close}
        aria-expanded="false"
        aria-controls="site-nav"
      >
        <span data-nav-label>{copy.menu}</span>
      </button>
    </div>
    <nav id="site-nav" class="site-nav" aria-label={copy.navLabel}>
      <ul>
        {
          copy.nav.map((item) => {
            const href = localizePath(locale, item.path);
            return (
              <li>
                <a href={href} aria-current={current === href ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            );
          })
        }
        <li class="lang-switch">
          <a href={altHref} hreflang={altLocale} lang={altLocale}>
            {altLabel}
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>
