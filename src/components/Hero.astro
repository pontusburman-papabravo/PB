---
interface Props {
  eyebrow: string;
  title: string;
  lede: string;
  statement?: string;
}

const { eyebrow, title, lede, statement } = Astro.props;
---

<section class="hero">
  <div class="wrap">
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    <p class="lede">{lede}</p>
    {statement && <p class="statement">{statement}</p>}
    <div class="cta-row">
      <slot />
    </div>
  </div>
</section>
