---
import { site } from '../data/site';

interface Props {
  title?: string;
  text?: string;
}

const {
  title = 'If this fits, get in touch.',
  text = 'A few lines on the situation and the timing are enough.',
} = Astro.props;
---

<section class="section contact-cta">
  <div class="wrap narrow">
    <h2>{title}</h2>
    <p class="lede">{text}</p>
    <div class="cta-row">
      <a class="button" href={site.ctaHref}>{site.ctaLabel}</a>
      <a class="text-link" href={`mailto:${site.email}`}>{site.email}</a>
    </div>
  </div>
</section>
