---
import { site } from '../data/site';

interface Props {
  title: string;
  text: string;
  href: string;
  label: string;
}

const { title, text, href, label } = Astro.props;
---

<section class="section contact-cta">
  <div class="wrap narrow">
    <h2>{title}</h2>
    <p class="lede">{text}</p>
    <div class="cta-row">
      <a class="button" href={href}>{label}</a>
      <a class="text-link" href={`mailto:${site.email}`}>{site.email}</a>
    </div>
  </div>
</section>
