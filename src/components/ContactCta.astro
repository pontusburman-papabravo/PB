---
import { site } from '../data/site';

interface Props {
  title?: string;
  text?: string;
}

const {
  title = 'If it might be a fit, write.',
  text = 'A short note about the situation and the timing is enough. Pontus reads it.',
} = Astro.props;
---

<section class="section contact-cta">
  <div class="wrap narrow">
    <h2>{title}</h2>
    <p class="lede">{text}</p>
    <div class="cta-row">
      <a class="button" href={site.ctaHref}>{site.ctaLabel}</a>
      <a class="text-link" href={`mailto:${site.email}`}>{site.email}</a>
    </div>
  </div>
</section>
