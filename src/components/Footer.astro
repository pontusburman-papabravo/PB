---
import { site } from '../data/site';
import { getCopy, localizePath, localeFromPath } from '../i18n';

interface Props {
  path: string;
}

const { path } = Astro.props;
const locale = localeFromPath(path);
const copy = getCopy(locale);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap footer-grid">
    <div>
      <p class="footer-name">{site.legalName}</p>
      <p class="footer-meta">{copy.orgLabel} {site.orgNumber}<br />{copy.location}</p>
    </div>
    <nav aria-label={copy.footerNavLabel}>
      <ul>
        {
          copy.nav.map((item) => (
            <li>
              <a href={localizePath(locale, item.path)}>{item.label}</a>
            </li>
          ))
        }
        <li><a href={localizePath(locale, '/privacy')}>{copy.privacyLabel}</a></li>
      </ul>
    </nav>
    <div class="footer-contact">
      <a href={`mailto:${site.email}`}>{site.email}</a>
      <a href={`tel:${site.phoneTel}`}>{site.phoneDisplay}</a>
      <a href={site.linkedIn} rel="me noopener noreferrer" target="_blank">
        {site.linkedInLabel}
        <span class="visually-hidden"> ({copy.newTab})</span>
      </a>
    </div>
  </div>
  <div class="wrap footer-base">
    <p>
      <a href={`${localizePath(locale, '/about')}#working-together`}>{copy.collaborate}</a>
    </p>
    <p>© {year} {site.legalName}</p>
  </div>
</footer>
