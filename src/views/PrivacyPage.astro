---
import Section from '../components/Section.astro';
import { site } from '../data/site';
import { getCopy, localizePath, type Locale } from '../i18n';
import BaseLayout from '../layouts/BaseLayout.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = getCopy(locale);
const page = copy.privacy;
const path = localizePath(locale, '/privacy');
const crumbs = [
  { name: copy.homeName, path: localizePath(locale, '/') },
  { name: copy.privacyLabel, path },
];
---

<BaseLayout title={page.title} description={page.description} path={path} breadcrumbs={crumbs}>
  <Section narrow>
    <p class="eyebrow">{page.eyebrow}</p>
    <h1>{page.h1}</h1>
    <p class="lede">{page.lede}</p>

    <h2>{page.notHeading}</h2>
    <p>{page.notBody}</p>

    <h2>{page.contactHeading}</h2>
    <p>{page.contactBody}</p>
    <p>{page.contactUse}</p>

    <h2>{page.logsHeading}</h2>
    <p>{page.logsBody}</p>

    <h2>{page.whoHeading}</h2>
    <p>
      {site.legalName}, {copy.orgLabel.toLowerCase()} {site.orgNumber}, {copy.location}.<br />
      <a href={`mailto:${site.email}`}>{site.email}</a>
    </p>
    <p class="note">{page.disclaimer}</p>
  </Section>
</BaseLayout>
