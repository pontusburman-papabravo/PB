---
import ContactCta from '../components/ContactCta.astro';
import ProductCards from '../components/ProductCards.astro';
import Section from '../components/Section.astro';
import { getCopy, localizePath, type Locale } from '../i18n';
import BaseLayout from '../layouts/BaseLayout.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = getCopy(locale);
const page = copy.productsPage;
const path = localizePath(locale, '/products');
const crumbs = [
  { name: copy.homeName, path: localizePath(locale, '/') },
  { name: copy.nav[1].label, path },
];
---

<BaseLayout title={page.title} description={page.description} path={path} breadcrumbs={crumbs}>
  <Section narrow>
    <p class="eyebrow">{page.eyebrow}</p>
    <h1>{page.h1}</h1>
    <p class="lede">{page.lede}</p>
    <p>{page.body}</p>
  </Section>

  <Section>
    <ProductCards items={copy.products} labels={copy.productLabels} newTab={copy.newTab} detailed />
  </Section>

  <ContactCta
    title={page.ctaTitle}
    text={page.ctaText}
    href={localizePath(locale, '/contact')}
    label={copy.ctaLabel}
  />
</BaseLayout>
