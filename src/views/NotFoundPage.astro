---
import { getCopy, localizePath, type Locale } from '../i18n';
import BaseLayout from '../layouts/BaseLayout.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = getCopy(locale);
const page = copy.notFound;
---

<BaseLayout title={page.title} description={page.description} path={localizePath(locale, '/404')} noindex>
  <section class="section">
    <div class="wrap narrow">
      <p class="eyebrow">{page.eyebrow}</p>
      <h1>{page.h1}</h1>
      <p class="lede">{page.lede}</p>
      <div class="cta-row">
        <a class="button" href={localizePath(locale, '/')}>{page.home}</a>
        <a class="text-link" href={localizePath(locale, '/consulting')}>{page.explore}</a>
        <a class="text-link" href={localizePath(locale, '/contact')}>{copy.ctaLabel}</a>
      </div>
    </div>
  </section>
</BaseLayout>
