---
import ContactCta from '../components/ContactCta.astro';
import Experience from '../components/Experience.astro';
import Section from '../components/Section.astro';
import { site } from '../data/site';
import { getCopy, localizePath, type Locale } from '../i18n';
import BaseLayout from '../layouts/BaseLayout.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = getCopy(locale);
const page = copy.about;
const path = localizePath(locale, '/about');
const crumbs = [
  { name: copy.homeName, path: localizePath(locale, '/') },
  { name: copy.nav[2].label, path },
];
---

<BaseLayout title={page.title} description={page.description} path={path} breadcrumbs={crumbs}>
  <Section narrow>
    <p class="eyebrow">{page.eyebrow}</p>
    <h1>{page.h1}</h1>
    <p class="lede">{page.lede}</p>
    <p>{page.intro}</p>
  </Section>

  <Section eyebrow={page.experienceEyebrow} title={page.experienceTitle}>
    {page.experienceParagraphs.map((paragraph) => <p>{paragraph}</p>)}
  </Section>

  <Section title={page.closeTitle}>
    {page.closeParagraphs.map((paragraph) => <p>{paragraph}</p>)}
  </Section>

  <Section eyebrow={page.careerEyebrow} title={page.careerTitle}>
    <Experience items={copy.experience} detailed />
    <p class="note">{page.careerNote}</p>
  </Section>

  <Section title={page.companyTitle}>
    {page.companyParagraphs.map((paragraph) => <p>{paragraph}</p>)}
    <p>
      <a href={site.linkedIn} rel="me noopener noreferrer" target="_blank">
        {page.linkedIn}
        <span class="visually-hidden"> ({copy.newTab})</span>
      </a>
    </p>
  </Section>

  <Section id="working-together" eyebrow={page.collabEyebrow} title={page.collabTitle}>
    {page.collabParagraphs.map((paragraph) => <p>{paragraph}</p>)}
    <p>
      <a href={`mailto:${site.email}?subject=${encodeURIComponent(page.collabSubject)}`}>{site.email}</a>
    </p>
  </Section>

  <ContactCta
    title={copy.home.ctaTitle}
    text={copy.home.ctaText}
    href={localizePath(locale, '/contact')}
    label={copy.ctaLabel}
  />
</BaseLayout>
