---
import ContactCta from '../components/ContactCta.astro';
import Experience from '../components/Experience.astro';
import Hero from '../components/Hero.astro';
import ProductCards from '../components/ProductCards.astro';
import Section from '../components/Section.astro';
import ServiceCards from '../components/ServiceCards.astro';
import { helpAreas } from '../data/assignments';
import { featuredExperience } from '../data/experience';
import { products } from '../data/products';
import { site } from '../data/site';
import { situations } from '../data/situations';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Technology leadership that turns into delivery | Papa Bravo"
  description="Pontus Burman helps organisations lead technology, product and transformation — from strategy through to delivery. Interim and fractional leadership from Stockholm."
  path="/"
>
  <Hero
    eyebrow="Technology, product and transformation"
    title="Technology leadership that turns into delivery."
    lede="Pontus Burman helps organisations lead technology, product and transformation — from strategy and organisation to actual delivery."
    statement={'Senior enough to lead. Hands\u2011on enough to know what delivery actually requires.'}
  >
    <a class="button" href={site.ctaHref}>{site.ctaLabel}</a>
    <a class="text-link" href="/consulting">Explore consulting</a>
  </Hero>
  <p class="hero-note wrap">Based in Stockholm. Assignments in Sweden and internationally.</p>

  <Section
    id="assignments"
    eyebrow="Where this fits"
    title="Need experienced leadership for what's next?"
    intro="The brief is rarely a job title. It is a situation that needs someone senior, who can stay with the work."
  >
    <ServiceCards items={helpAreas} />
  </Section>

  <Section
    id="situations"
    eyebrow="Situations"
    title="When I can help"
    intro="A few of the problems organisations ask about. If one of them is close, it is worth a conversation."
  >
    <ol class="situation-list">
      {
        situations.map((item) => (
          <li>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </li>
        ))
      }
    </ol>
    <p class="section-follow">
      <a class="text-link" href="/consulting">See how an assignment works</a>
    </p>
  </Section>

  <Section
    id="experience"
    eyebrow="Background"
    title="Selected experience"
    intro="Organisations where this kind of leadership has already been done. Not a full CV — the context is on the about page."
  >
    <Experience items={featuredExperience} />
    <p class="section-follow">
      <a class="text-link" href="/about">Read about Pontus</a>
    </p>
  </Section>

  <Section
    id="building"
    eyebrow="Proof of work"
    title="Still building"
    intro="Building products keeps the advisory work close to the realities behind strategy — users, architecture, delivery, analytics, distribution, operations and growth."
  >
    <ProductCards items={products} />
    <p class="section-follow">
      <a class="text-link" href="/products">See the products</a>
    </p>
  </Section>

  <Section id="about-teaser" narrow>
    <p class="personal">
      I'm Pontus Burman, founder of Papa Bravo. Much of my career has been spent leading technology,
      product and transformation in organisations with very different problems. Today that work sits
      alongside building and operating digital products.
    </p>
    <p class="section-follow">
      <a class="text-link" href="/about">About Pontus</a>
    </p>
  </Section>

  <ContactCta
    title="Have a technology or transformation challenge?"
    text="If you're looking for experienced leadership across technology, product or transformation, let's talk."
  />
</BaseLayout>
