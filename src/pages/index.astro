---
import ContactCta from '../components/ContactCta.astro';
import Experience from '../components/Experience.astro';
import Hero from '../components/Hero.astro';
import ProductCards from '../components/ProductCards.astro';
import Section from '../components/Section.astro';
import { featuredExperience } from '../data/experience';
import { products } from '../data/products';
import { site } from '../data/site';
import { situations } from '../data/situations';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Technology leadership that turns into delivery | Papa Bravo"
  description="Pontus Burman takes interim and advisory assignments in technology, product and transformation. Papa Bravo, Stockholm."
  path="/"
>
  <Hero
    eyebrow="Interim leadership · Technology · Product · Transformation"
    title="Technology leadership that turns into delivery."
    lede="Pontus Burman, founder of Papa Bravo, takes interim and advisory assignments and stays with them through delivery."
    statement="Senior enough to lead. Close enough to the work to know what delivery actually takes."
    meta="Based in Stockholm. Assignments in Sweden and internationally."
  >
    <a class="button" href={site.ctaHref}>{site.ctaLabel}</a>
    <a class="text-link" href="/consulting">Explore consulting</a>
    <aside slot="aside" class="assignment-rail" aria-label="Typical assignments">
      <p>Typical assignments</p>
      <ul>
        <li>Interim CTO / CIO</li>
        <li>Technology transformation</li>
        <li>Product and technology leadership</li>
        <li>Senior technology advisory</li>
      </ul>
    </aside>
  </Hero>

  <Section
    id="situations"
    eyebrow="Situations"
    title="What people actually write about"
    intro="The brief is rarely a job title. These are closer to the notes that start a conversation."
  >
    <ol class="situation-list">
      {
        situations.map((item) => (
          <li>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </li>
        ))
      }
    </ol>
    <p class="section-follow">
      <a class="text-link" href="/consulting">See how an assignment works</a>
    </p>
  </Section>

  <Section
    id="experience"
    eyebrow="Background"
    title="Selected experience"
    intro="Not a logo wall, and not a full CV. The organisations, and the role at the time. The context is on the about page."
  >
    <Experience items={featuredExperience} />
    <p class="section-follow">
      <a class="text-link" href="/about">Read about Pontus</a>
    </p>
  </Section>

  <Section
    id="building"
    eyebrow="Proof of work"
    title="Still building"
    intro="Two products in production, not case studies. They are why the consulting can be specific about users, release and the week after launch."
  >
    <ProductCards items={products} />
    <p class="section-follow">
      <a class="text-link" href="/products">See the products</a>
    </p>
  </Section>

  <Section id="about-teaser" narrow>
    <p class="personal">
      I'm Pontus Burman. Papa Bravo is the company. Most of what people hire me for sits between a
      technology decision and the week it has to be delivered. I still build products, because the
      advice gets vague when I stop doing the work.
    </p>
    <p class="section-follow">
      <a class="text-link" href="/about">About Pontus</a>
    </p>
  </Section>

  <ContactCta
    title="If the situation sounds familiar"
    text="Write a few lines about what is going on, and when it needs to move. Pontus reads it."
  />
</BaseLayout>
