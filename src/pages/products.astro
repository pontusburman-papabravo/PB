---
import ContactCta from '../components/ContactCta.astro';
import ProductCards from '../components/ProductCards.astro';
import Section from '../components/Section.astro';
import { products } from '../data/products';
import BaseLayout from '../layouts/BaseLayout.astro';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Products', path: '/products' },
];
---

<BaseLayout
  title="Products I build | My Star Day and Körpasset | Papa Bravo"
  description="My Star Day and Körpasset are live products built and run by Papa Bravo. They are why the consulting stays close to delivery."
  path="/products"
  breadcrumbs={crumbs}
>
  <Section narrow>
    <p class="eyebrow">Products</p>
    <h1>Two products, both in production.</h1>
    <p class="lede">
      My Star Day and Körpasset are not concepts, and they are not client work. Pontus designs
      them, ships them and keeps them running.
    </p>
    <p>
      That is also why an assignment can go past the recommendation. The same person has had to
      deal with onboarding, app stores, payments, analytics and a Tuesday when something breaks.
    </p>
  </Section>

  <Section>
    <ProductCards items={products} detailed />
  </Section>

  <ContactCta
    title="The products are ours. The consulting is for your organisation."
    text="If you need someone who has done both the leadership and the building, write to Pontus."
  />
</BaseLayout>
