---
import ContactCta from '../components/ContactCta.astro';
import Section from '../components/Section.astro';
import ServiceCards from '../components/ServiceCards.astro';
import { typicalAssignments, waysOfWorking } from '../data/assignments';
import { situations } from '../data/situations';
import BaseLayout from '../layouts/BaseLayout.astro';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Consulting', path: '/consulting' },
];
---

<BaseLayout
  title="Interim CTO, CIO and transformation leadership | Papa Bravo"
  description="Senior assignments with Pontus Burman: interim CTO or CIO, fractional technology leadership, transformation, and product and technology. Based in Stockholm, Sweden."
  path="/consulting"
  breadcrumbs={crumbs}
>
  <Section narrow>
    <p class="eyebrow">Consulting</p>
    <h1>Assignments with Pontus Burman.</h1>
    <p class="lede">
      Papa Bravo is the company. The person you work with is Pontus. The shape is interim, a
      fraction of the week, or a defined advisory piece — whichever fits the problem.
    </p>
    <p>
      Based in Stockholm. The work happens with teams in Sweden and internationally, on site or at
      a distance. There is no package. The brief decides.
    </p>
  </Section>

  <Section eyebrow="Roles" title="Typical assignments">
    <ServiceCards items={typicalAssignments} />
  </Section>

  <Section
    eyebrow="Situations"
    title="Where an outside person is useful"
    intro="Often the organisation already has capable people. What is missing is someone who can sit in the business conversation and the delivery conversation, and say what is not working."
  >
    <ol class="situation-list">
      {
        situations.map((item) => (
          <li>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </li>
        ))
      }
    </ol>
  </Section>

  <Section eyebrow="Approach" title="How I work">
    <ol class="approach-list">
      {
        waysOfWorking.map((item, index) => (
          <li>
            <span class="approach-index" aria-hidden="true">
              {String(index + 1).padStart(2, '0')}
            </span>
            <div>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </Section>

  <ContactCta
    title="Describe the situation"
    text="What is going on, when it needs to move, and what kind of leadership you are looking for. A short note is enough to see if it fits."
  />
</BaseLayout>
